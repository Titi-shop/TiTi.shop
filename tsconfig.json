{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],

    "allowJs": false,                // ⛔ không cho JS lẫn TS
    "skipLibCheck": true,           // ✅ bắt lỗi type thật
    "strict": true,
    "noEmit": true,

    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,

    "noUncheckedIndexedAccess": true, // 🔐 chống undefined
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,

    "plugins": [{ "name": "next" }],

    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "types/**/*.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
